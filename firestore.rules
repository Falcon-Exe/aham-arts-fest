rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper to check if user is authenticated and is admin
    function isAdmin() {
      // In a real app, you might check a 'role' claim on the auth token.
      // For now, any authenticated user via Firebase Auth is considered an admin 
      // since the app uses basic email/password for the admin dashboard.
      return request.auth != null;
    }

    // Helper to check if field is a string and meets minimum length
    function isValidString(text, minLen) {
      return text is string && text.size() >= minLen;
    }

    // Public Collections: Public Read, Admin Write
    match /events/{event} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /results/{result} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /announcements/{announcement} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /stats/{stat} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /settings/{setting} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Registration Data Contract Verification
    match /registrations/{registration} {
      allow read: if true;
      
      // Strict Schema Validation
      allow create: if 
        // 1. Only allow specific keys
        request.resource.data.keys().hasOnly([
          "fullName", "chestNumber", "team", "class", "section", 
          "cicNumber", "phone", "email", "events", "createdAt"
        ])
        // 2. Required fields exist
        && request.resource.data.keys().hasAll([
          "fullName", "chestNumber", "team", "class", "createdAt"
        ])
        // 3. Field Types and Constraints
        && isValidString(request.resource.data.fullName, 3)
        && request.resource.data.team in ["PYRA", "IGNIS", "ATASH"]
        && request.resource.data.chestNumber.matches("^[A-Z0-9]{3,10}$")
        && request.resource.data.class is string
        && request.resource.data.events is list;
        
      allow update, delete: if isAdmin();
    }

    match /teams/{team} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /gallery/{item} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /students/{student} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /student_profiles/{profile} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /teamScores/{teamScore} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /auditLogs/{log} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}
